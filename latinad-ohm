    <style>
        :root {
            --primary-color: #0d6efd;
            --border-color: #e3e3e3;
            --text-dark: #404040;
            --text-muted: #737373;
            --sidebar-width: 260px;
            --header-height: 60px;
        }

        body {
            font-family: 'Roboto', sans-serif;
            background-color: #efefef;
            color: var(--text-dark);
            font-size: 13px;
            overflow-x: hidden;
        }

        /* --- LAYOUT PLATAFORMA --- */
        .be-wrapper { display: flex; flex-direction: column; min-height: 100vh; }
        
        .be-top-header { 
            background: #fff; 
            height: var(--header-height); 
            border-bottom: 1px solid var(--border-color); 
            z-index: 1030; 
            padding: 0 20px;
        }
        .be-navbar-header { display: flex; align-items: center; width: var(--sidebar-width); }
        .be-toggle-left-sidebar { font-size: 24px; color: var(--text-dark); margin-right: 15px; }
        
        .be-left-sidebar { 
            position: fixed; 
            top: var(--header-height); 
            left: 0; 
            width: var(--sidebar-width); 
            height: calc(100vh - var(--header-height)); 
            background: #fff; 
            border-right: 1px solid var(--border-color); 
            z-index: 1020; 
            overflow-y: auto; 
        }
        
        .be-content { 
            margin-left: var(--sidebar-width); 
            margin-top: var(--header-height); 
            min-height: calc(100vh - var(--header-height)); 
            background-color: #efefef;
        }

        /* --- MENÚ LATERAL --- */
        .sidebar-elements { list-style: none; padding: 0; margin: 0; }
        .sidebar-elements .divider { padding: 12px 20px; font-weight: 700; color: #999; text-transform: uppercase; font-size: 11px; background: #f9f9f9; }
        .sidebar-elements > li > a { display: flex; align-items: center; padding: 12px 20px; color: var(--text-dark); text-decoration: none; border-left: 3px solid transparent; font-size: 13px; }
        .sidebar-elements > li > a i { font-size: 18px; margin-right: 10px; color: var(--text-muted); width: 20px; text-align: center; }
        .sidebar-elements > li:hover > a { background: #f5f5f5; }
        .sidebar-elements > li.active > a { background: #f0f4ff; color: var(--primary-color); border-left-color: var(--primary-color); font-weight: 500; }
        .sidebar-elements > li.active > a i { color: var(--primary-color); }
        
        .sidebar-elements .sub-menu { list-style: none; padding: 0; margin: 0; display: none; background: #fafafa; }
        .sidebar-elements .sub-menu a { padding: 10px 20px 10px 50px; display: block; color: var(--text-muted); text-decoration: none; font-size: 13px; }
        .sidebar-elements .sub-menu a:hover { color: var(--primary-color); }
        .sidebar-elements .sub-menu li.active > a { color: var(--primary-color); font-weight: 500; }

        /* --- Estilos Generales Dashboard --- */
        .page-head { padding: 15px 25px; background: #fff; border-bottom: 1px solid var(--border-color); }
        .page-head-nav { margin-bottom: 0; padding: 0; background: transparent; font-size: 14px; }
        .breadcrumb-item + .breadcrumb-item::before { content: "\F0142"; font-family: "Material Design Icons"; vertical-align: middle; }

        .card { border-radius: 3px; border: 1px solid var(--border-color); box-shadow: 0 1px 1px rgba(0,0,0,0.05); margin-bottom: 25px; background: #fff; }
        .card-header { background: transparent; border-bottom: 1px solid var(--border-color); padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; }
        .card-title { font-size: 16px; font-weight: 400; margin: 0; }
        .card-border-color-primary { border-top: 3px solid var(--primary-color); }
        .card-header-divider { border-bottom: 1px solid var(--border-color); margin-bottom: 15px; }

        /* Filtros y Tablas */
        .table-filters-container { padding: 15px 25px; }
        .table-filter-title { font-weight: 700; font-size: 11px; color: var(--text-muted); display: block; margin-bottom: 5px; }
        .form-control-sm { height: 34px; font-size: 13px; border-radius: 3px; border: 1px solid #ccc; }
        .btn-filter { height: 34px; font-size: 13px; padding: 0 15px; line-height: 1.5; }
        .spacer-label { color: transparent; user-select: none; }
        
        .table-responsive { overflow-x: auto; margin-bottom: 0; }
        .table thead th { background-color: #fff; font-weight: 700; font-size: 11px; color: #404040; border-bottom: 2px solid var(--border-color); border-top: 0; padding: 10px 5px; vertical-align: middle; }
        .table tbody td { vertical-align: middle; border-color: var(--border-color); padding: 8px 5px; }
        
        /* Específico Calendario Semanal */
        .item-week { width: 25px; min-width: 25px; text-align: center; padding: 4px 0 !important; border-left: 1px solid #f0f0f0; }
        .item-week small { font-size: 11px; color: #555; }
        .table-active { background-color: #ffffff !important; }
        .table-sold { background-color: #e34b46 !important; } .table-sold small { color: #ffffff !important; }
        .table-partial { background-color: #ffb822 !important; } .table-partial small { color: #ffffff !important; }
        .table-reserved { background-color: #808080 !important; } .table-reserved small { color: #ffffff !important; }
        .table-blocked { background-color: #8e3d36 !important; } .table-blocked small { color: #ffffff !important; }
        
        .slot-row { display: none; background-color: #fafafa; }
        .slot-row td { padding: 4px; font-size: 12px; border-top: 1px dashed var(--border-color); }
        .be-spinner { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.7); display: none; justify-content: center; align-items: center; z-index: 10; }
        .be-spinner svg { animation: spin 2s linear infinite; stroke: var(--primary-color); }
        @keyframes spin { 100% { transform: rotate(360deg); } }

        /* Badges y utilidades */
        .legend-list .list-inline-item { margin-right: 10px; }
        .badge { font-weight: 500; padding: 5px 8px; font-size: 11px; border-radius: 3px; }
        .badge-danger { background-color: #e34b46; color: #fff; }
        .badge-warning { background-color: #ffb822; color: #fff; }
        .badge-secondary { background-color: #808080; color: #fff; }
        .badge-info { background-color: #5d9cec; color: #fff; }
        .badge-success { background-color: #28a745; color: #fff; }
        .cursor-not-allowed { cursor: not-allowed; }
        .cursor-pointer { cursor: pointer; }
        
        .text-bold { font-weight: 700; }
        .h4-font-size { font-size: 1.5rem; font-weight: 500; color: var(--text-dark); }
        
        /* Nav Tabs Estilo OOH Alineadas y centradas */
        .nav-tabs-custom { border-bottom: 2px solid var(--border-color); padding-left: 0 !important; }
        .nav-tabs-custom .nav-link { 
            border: 0; 
            color: var(--text-muted); 
            font-weight: 500; 
            padding: 10px 25px; 
            font-size: 14px; 
            text-align: center;
        }
        .nav-tabs-custom .nav-link.active { 
            color: var(--primary-color); 
            border-bottom: 3px solid var(--primary-color); 
            background: transparent; 
        }

        .no-caret::after { display: none !important; }

        /* Estilos Latinad */
        .latinad-btn-group .btn { border: 1px solid #ced4da; background: #fff; color: #495057; font-size: 12px; }
        .latinad-btn-group .btn.active { background: #6c757d; color: #fff; border-color: #6c757d; }
        .btn-add-ad { background-color: #3eb88f; border-color: #3eb88f; color: #fff; font-size: 13px; font-weight: 500; }
        .btn-add-ad:hover { background-color: #35a77f; border-color: #35a77f; color: #fff; }
        
        .latinad-screen-card-compact { 
            border: 1px solid #e0e0e0; 
            border-radius: 4px; 
            padding: 10px 12px; 
            margin-bottom: 10px; 
            background: #fff; 
        }

        /* Overlay de carga simulada dentro del modal */
        .modal-loading-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(255, 255, 255, 0.92);
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 1060;
            border-radius: 4px;
        }
        .modal-loading-overlay .spinner-border { width: 3rem; height: 3rem; color: var(--primary-color); }
    </style>
</head>
