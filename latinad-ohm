    // Lógica para procesar la creación unificada con simulación de carga de 4 segundos
    function procesarCreacionUnificada() {
        $('#modal-loading-overlay').css('display', 'flex');
        
        // Simular tiempo de comunicación con la API (4.0 segundos)
        setTimeout(() => {
            $('#modal-loading-overlay').hide();
            $('#modal-crear-anuncio-unificado').modal('hide');
            
            // Deshabilitar botón de crear anuncio
            $('#btn-crear-anuncio').attr('disabled', true).addClass('disabled');
            
            // Habilitar ícono de engranaje en la tabla
            $('#btn-gear-config').prop('disabled', false).removeClass('text-secondary').addClass('text-primary');
            
            // Actualizar fila con los datos retornados
            $('#cell-latinad-id').text('SCR-8821');
            $('#cell-latinad-status').html('<span class="badge badge-success">Vinculado / Programado</span>');
            
            // Mostrar modal verde de éxito
            $('#modal-exito').modal('show');
        }, 4000);
    }

    // Apertura limpia del modal de configuración desde el engranaje
    function abrirModalConfiguracion() {
        if(!$('#btn-gear-config').is(':disabled')) {
            $('#modal-config-pantalla').modal('show');
