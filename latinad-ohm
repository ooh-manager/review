    const weeksList = ["07", "14", "21", "28", "05", "12", "19", "26", "02", "09", "16", "23", "30", "07", "14", "21", "28", "04", "11", "18", "25", "01", "08", "15", "22"];

    const supportData = [
        { code: 'T-001', type: 'Mobiliario Urbano Impreso', name: 'Soporte 001 Valla - Concepción', comuna: 'Vitacura', units: 2, state: 'active' },
        { code: 'T-002', type: 'Valla', name: 'Soporte 002 Valla - Renca', comuna: 'Renca', units: 0, state: 'sold' },
        { code: 'T-003', type: 'Caminero', name: 'Soporte 003 Caminero - Tiltil', comuna: 'Tiltil', units: 0, state: 'reserved' }
    ];

    function initTable() {
        const body = document.getElementById('tableBody');
        let html = '';

        supportData.forEach((item) => {
            const hasUnits = item.units > 0;
            const rowStateClass = `table-${item.state}`;
            const randomLatinad = Math.floor(Math.random() * 101) + '%';
            
            html += `<tr class="item-row">
                <td class="text-bold text-nowrap">${item.code}</td>
                <td class="truncated-fit" ${!hasUnits ? 'colspan="2"' : ''}><span>${item.type}</span></td>
                ${hasUnits ? `<td class="text-center p-0"><a class="toggle-slots text-secondary" href="javascript:void(0)" onclick="toggleUnits('${item.code}')"><i class="icon mdi mdi-tv-list mdi-hc-lg"></i></a></td>` : ''}
                <td><span>${item.name}</span></td>
                <td>${item.comuna}</td>
                <td class="text-center font-weight-bold text-secondary">${randomLatinad}</td>`;
                
            weeksList.forEach(day => {
                html += `<td class="item-week ${hasUnits ? 'table-active' : rowStateClass}"><small>${day}</small></td>`;
            });
            html += `</tr>`;
        });

        body.innerHTML = html;
        $('[data-toggle="tooltip"]').tooltip();
    }

    function toggleUnits(code) { $(`.slot-${code}`).toggle(); }

    function simulateFilter() {
        const activeSpinner = $('.view-section:visible .be-spinner');
        if(activeSpinner.length > 0) {
            activeSpinner.css('display', 'flex');
            setTimeout(() => { activeSpinner.hide(); }, 600);
        }
    }

    $(document).ready(() => {
        initTable();
        
        // Manejo fluido del menú lateral desplegable
        $('.sidebar-elements .parent > a').off('click').on('click', function(e) {
            e.preventDefault();
            const parentLi = $(this).parent();
            parentLi.toggleClass('open');
            parentLi.children('.sub-menu').stop(true, true).slideToggle(200);
        });
    });
</script>

</body>
</html>
